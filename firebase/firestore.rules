rules_version = '2';
// Regras do Localizador de Estacas — validadas no servidor do Firebase.
// Administrador principal: único que gerencia usuários, perfis, convites e a base do projeto.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'igordalmolin.eng@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function hasMe() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    // permissões efetivas: as próprias do usuário (custom) ou as do perfil
    function permsOf(u) {
      return u.custom == true || u.profile == null
        ? u.perms
        : get(/databases/$(database)/documents/profiles/$(u.profile)).data.perms;
    }
    function canView(p, page) { return p.get(page, {}).get('view', false) == true; }
    function canDo(page, act) { return isAdmin() || (hasMe() && me().active == true && permsOf(me()).get(page, {}).get(act, false) == true); }
    function marcoOk(d) {
      return d.cat in ['bota', 'rot', 'perim', 'ent', 'agua', 'obs'] && d.rod in ['BR-277', 'BR-373']
          && d.km is string && d.km.size() <= 20 && d.id is string && d.id.size() <= 80;
    }
    // Levantamento de Bota-Espera: formato mínimo de cada registro
    function levOk(d) {
      return d.id is string && d.id.size() <= 60 && d.tipo in ['EXISTENTE', 'LOCAL_POSSIVEL'] && d.pista in ['CRESCENTE', 'DECRESCENTE']
          && (d.tipo == 'LOCAL_POSSIVEL' ? d.ocupacao == null : d.ocupacao in ['VAZIO', 'PELA_METADE', 'LOTADO'])
          && d.rodovia in ['BR-277/PR', 'BR-373/PR'] && d.lote in [2, 3, 4] && d.lat is number && d.lon is number
          && d.criado_em is int && d.criado_por is string && d.excluido is bool && d.obs is string && d.obs.size() <= 2000
          && d.fotos is list && d.fotos.size() <= 30 && d.audios is list && d.audios.size() <= 30;
    }
    function levRead() { return isAdmin() || (hasMe() && me().active == true && canView(permsOf(me()), 'levbe')); }
    function anyView(p) {
      return canView(p, 'localizacao') || canView(p, 'mapa') || canView(p, 'mapab4') || canView(p, 'calculadora')
          || canView(p, 'analise') || canView(p, 'marcos') || canView(p, 'foto') || canView(p, 'relatorios')
          || canView(p, 'levbe');
    }
    function activeWithAccess() { return hasMe() && me().active == true && anyView(permsOf(me())); }
    function emailKey() { return request.auth.token.email.lower(); }

    // Base do projeto BR-277 (R08 + estacas): só para usuários ativos com alguma página liberada
    // (o app usa esta base em todas as páginas, inclusive para abrir)
    match /base/r08 {
      allow read: if isAdmin() || activeWithAccess();
      allow write: if isAdmin();
    }
    // Seriais dos apontamentos (planilha importada pelo administrador na Calculadora)
    match /base/seriais {
      allow read: if isAdmin() || activeWithAccess();
      allow write: if isAdmin();
    }
    // Último horário de cada equipe (Calculadora): lê quem tem a Calculadora; grava quem emite programação
    match /equipeHoras/{id} {
      allow read: if isAdmin() || (hasMe() && me().active == true && canView(permsOf(me()), 'calculadora'));
      allow write: if canDo('calculadora', 'create') && request.resource.data.keys().hasOnly(['equipe', 'h', 'at', 'by'])
                   && request.resource.data.equipe is string && request.resource.data.h is map && request.resource.data.at is int;
    }
    // Marcos do trecho (bota-esperas, rotatórias, perímetros urbanos, entradas, água outorgada, observações): um documento por marco
    match /marcos/{id} {
      allow read: if isAdmin() || (hasMe() && me().active == true && canView(permsOf(me()), 'marcos'));
      allow create: if canDo('marcos', 'create') && marcoOk(request.resource.data) && request.resource.data.id == id;
      allow update: if canDo('marcos', 'edit') && marcoOk(request.resource.data) && request.resource.data.id == id;
      allow delete: if canDo('marcos', 'delete');
    }
    // Levantamento de Bota-Espera: cria quem tem "registrar" (sempre em nome próprio); o autor complementa e desfaz os próprios;
    // "editar" corrige qualquer um sem excluir; "excluir" só marca a exclusão (lógica). Nunca apaga o documento.
    match /levantamento_bota_espera/{id} {
      allow read: if levRead();
      allow create: if canDo('levbe', 'create') && levOk(request.resource.data) && request.resource.data.id == id
                    && request.resource.data.criado_por == request.auth.token.email && request.resource.data.excluido == false;
      allow update: if levOk(request.resource.data) && request.resource.data.id == id
                    && request.resource.data.criado_por == resource.data.criado_por && request.resource.data.criado_em == resource.data.criado_em
                    && ((canDo('levbe', 'create') && resource.data.criado_por == request.auth.token.email)
                        || (canDo('levbe', 'edit') && request.resource.data.excluido == resource.data.excluido)
                        || (canDo('levbe', 'delete') && request.resource.data.diff(resource.data).affectedKeys()
                              .hasOnly(['excluido', 'excluido_em', 'excluido_por', 'excluido_motivo', 'atualizado_em', 'atualizado_por'])));
      allow delete: if false;
    }
    // fotos e áudios comprimidos do levantamento (um documento por arquivo, até ~700 KB)
    match /levantamento_bota_espera_midia/{id} {
      allow read: if levRead();
      allow create: if (canDo('levbe', 'create') || canDo('levbe', 'edit')) && request.resource.data.id == id
                    && request.resource.data.tipo in ['foto', 'audio'] && request.resource.data.data is string && request.resource.data.data.size() < 1000000
                    && request.resource.data.reg is string && request.resource.data.criado_por == request.auth.token.email;
      allow update, delete: if false;
    }
    // Base da BR-373 B4 (Lote 04): usuários ativos com "Estacas BR-373 B4", Calculadora, Análise por km, Marcos, Localização estaca ou Foto georreferenciada
    match /base/b4 {
      allow read: if isAdmin() || (hasMe() && me().active == true && (canView(permsOf(me()), 'mapab4') || canView(permsOf(me()), 'calculadora') || canView(permsOf(me()), 'analise') || canView(permsOf(me()), 'marcos')
                    || canView(permsOf(me()), 'localizacao') || canView(permsOf(me()), 'foto') || canView(permsOf(me()), 'levbe')));
      allow write: if isAdmin();
    }

    // Usuários
    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow update, delete: if isAdmin();
      // primeiro acesso: o próprio usuário cria o registro
      //  - com convite do administrador: exatamente o perfil/permissões do convite
      //  - sem convite: inativo e sem nenhuma permissão, até o administrador autorizar
      allow create: if isAdmin() || (
        signedIn() && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly(['email','name','profile','custom','perms','active','createdAt','invited'])
        && (
          (exists(/databases/$(database)/documents/invites/$(emailKey()))
            && request.resource.data.profile == get(/databases/$(database)/documents/invites/$(emailKey())).data.profile
            && request.resource.data.custom == get(/databases/$(database)/documents/invites/$(emailKey())).data.custom
            && request.resource.data.perms == get(/databases/$(database)/documents/invites/$(emailKey())).data.perms
            && request.resource.data.active == get(/databases/$(database)/documents/invites/$(emailKey())).data.active
            && request.resource.data.invited == true)
          ||
          (request.resource.data.active == false
            && request.resource.data.profile == null
            && request.resource.data.custom == true
            && request.resource.data.perms == {}
            && request.resource.data.invited == false)
        )
      );
    }

    // Perfis de acesso
    match /profiles/{id} {
      allow read: if isAdmin() || hasMe();
      allow write: if isAdmin();
    }

    // Convites (cadastro prévio feito pelo administrador)
    match /invites/{email} {
      allow read: if isAdmin() || (signedIn() && emailKey() == email);
      allow write: if isAdmin();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
