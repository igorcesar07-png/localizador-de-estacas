rules_version = '2';
// Regras do Localizador de Estacas — validadas no servidor do Firebase.
// Administrador principal: único que gerencia usuários, perfis, convites e a base do projeto.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'igordalmolin.eng@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function hasMe() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    // permissões efetivas: as próprias do usuário (custom) ou as do perfil
    function permsOf(u) {
      return u.custom == true || u.profile == null
        ? u.perms
        : get(/databases/$(database)/documents/profiles/$(u.profile)).data.perms;
    }
    function canView(p, page) { return p.get(page, {}).get('view', false) == true; }
    function canDo(page, act) { return isAdmin() || (hasMe() && me().active == true && permsOf(me()).get(page, {}).get(act, false) == true); }
    function marcoOk(d) {
      return d.cat in ['bota', 'rot', 'perim', 'ent', 'agua', 'obs'] && d.rod in ['BR-277', 'BR-373']
          && d.km is string && d.km.size() <= 20 && d.id is string && d.id.size() <= 80;
    }
    // Levantamento de Bota-Espera: formato mínimo de cada registro
    function levOk(d) {
      return d.id is string && d.id.size() <= 60 && d.tipo in ['EXISTENTE', 'LOCAL_POSSIVEL'] && d.pista in ['CRESCENTE', 'DECRESCENTE']
          && (d.tipo == 'LOCAL_POSSIVEL' ? d.ocupacao == null : d.ocupacao in ['VAZIO', 'PELA_METADE', 'LOTADO'])
          && d.rodovia in ['BR-277/PR', 'BR-373/PR'] && d.lote in [2, 3, 4] && d.lat is number && d.lon is number
          && d.criado_em is int && d.criado_por is string && d.excluido is bool && d.obs is string && d.obs.size() <= 2000
          && d.fotos is list && d.fotos.size() <= 30 && d.audios is list && d.audios.size() <= 30;
    }
    // Histórico de programações
    function hpRead() { return isAdmin() || (hasMe() && me().active == true && canView(permsOf(me()), 'histprog')); }
    function hpOk(d, id) {
      return d.id == id && d.data is string && d.data.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && d.equipe is string && d.equipe.size() > 0 && d.equipe.size() <= 120
          && d.obra is string && d.srck in ['277', 'B4'] && d.criado_em is int && d.criado_por is string && d.atualizado_em is int && d.atualizado_por == request.auth.token.email
          && d.excluido is bool && d.revisao is int;
    }
    // Levantamento de Patologias: formato mínimo de cada ocorrência
    function patOk(d) {
      return d.id is string && d.id.size() <= 60 && d.patologia in ['PANELA'] && d.pista in ['CRESCENTE', 'DECRESCENTE'] && d.faixa in ['F1', 'F2']
          && d.rodovia in ['BR-277/PR', 'BR-373/PR'] && d.lote in [2, 3, 4] && d.lat is number && d.lon is number
          && d.criado_em is int && d.criado_por is string && d.excluido is bool && d.obs is string && d.obs.size() <= 2000
          && d.fotos is list && d.fotos.size() <= 30 && d.audios is list && d.audios.size() <= 30;
    }
    function patRead() { return isAdmin() || (hasMe() && me().active == true && canView(permsOf(me()), 'levpat')); }
    function rmpRead() { return isAdmin() || (hasMe() && me().active == true && (canView(permsOf(me()), 'rmp') || canView(permsOf(me()), 'producao'))); }
    function rmpOk(d, id) {
      return d.id == id && d.id is string && d.id.size() <= 80 && d.seg is string && d.fotos is map && d.patologias is list && d.patologias.size() <= 10
          && d.atualizado_por == request.auth.token.email && d.atualizado_em is int;
    }
    function rdoRead() { return isAdmin() || (hasMe() && me().active == true && (canView(permsOf(me()), 'rdo') || canView(permsOf(me()), 'producao'))); }
    function pesOk(d) {
      return d.nome is string && d.nome.size() > 1 && d.nome.size() <= 120 && d.funcao is string && d.funcao.size() <= 80
          && d.papel in ['eng', 'enc', 'fis', 'outro'] && d.ativo is bool && d.docs is list
          && (d.get('assinatura', '') == '' || (d.assinatura is string && d.assinatura.size() < 200000));
    }
    function levRead() { return isAdmin() || (hasMe() && me().active == true && canView(permsOf(me()), 'levbe')); }
    function anyView(p) {
      return canView(p, 'localizacao') || canView(p, 'mapa') || canView(p, 'mapab4') || canView(p, 'calculadora')
          || canView(p, 'analise') || canView(p, 'marcos') || canView(p, 'foto') || canView(p, 'relatorios')
          || canView(p, 'levbe') || canView(p, 'levpat') || canView(p, 'producao') || canView(p, 'rmp') || canView(p, 'rdo');
    }
    function activeWithAccess() { return hasMe() && me().active == true && anyView(permsOf(me())); }
    function emailKey() { return request.auth.token.email.lower(); }

    // Base do projeto BR-277 (R08 + estacas): só para usuários ativos com alguma página liberada
    // (o app usa esta base em todas as páginas, inclusive para abrir)
    // Versões do projeto (unifilares) com data de corte: lê quem usa o app; só o administrador cadastra
    match /base_versoes/{id} {
      allow read: if isAdmin() || activeWithAccess();
      allow write: if isAdmin();
    }
    match /base_versoes_dados/{id} {
      allow read: if isAdmin() || activeWithAccess();
      allow write: if isAdmin();
    }
    match /base/r08 {
      allow read: if isAdmin() || activeWithAccess();
      allow write: if isAdmin();
    }
    // Seriais dos apontamentos (planilha importada pelo administrador na Calculadora)
    match /base/seriais {
      allow read: if isAdmin() || activeWithAccess();
      allow write: if isAdmin();
    }
    // Último horário de cada equipe (Calculadora): lê quem tem a Calculadora; grava quem emite programação
    match /equipeHoras/{id} {
      allow read: if isAdmin() || (hasMe() && me().active == true && canView(permsOf(me()), 'calculadora'));
      allow write: if canDo('calculadora', 'create') && request.resource.data.keys().hasOnly(['equipe', 'h', 'at', 'by'])
                   && request.resource.data.equipe is string && request.resource.data.h is map && request.resource.data.at is int;
    }
    // Marcos do trecho (bota-esperas, rotatórias, perímetros urbanos, entradas, água outorgada, observações): um documento por marco
    match /marcos/{id} {
      allow read: if isAdmin() || (hasMe() && me().active == true && canView(permsOf(me()), 'marcos'));
      allow create: if canDo('marcos', 'create') && marcoOk(request.resource.data) && request.resource.data.id == id;
      allow update: if canDo('marcos', 'edit') && marcoOk(request.resource.data) && request.resource.data.id == id;
      allow delete: if canDo('marcos', 'delete');
    }
    // Levantamento de Bota-Espera: cria quem tem "registrar" (sempre em nome próprio); o autor complementa e desfaz os próprios;
    // "editar" corrige qualquer um sem excluir; "excluir" só marca a exclusão (lógica). Nunca apaga o documento.
    match /levantamento_bota_espera/{id} {
      allow read: if levRead();
      allow create: if canDo('levbe', 'create') && levOk(request.resource.data) && request.resource.data.id == id
                    && request.resource.data.criado_por == request.auth.token.email && request.resource.data.excluido == false;
      allow update: if levOk(request.resource.data) && request.resource.data.id == id
                    && request.resource.data.criado_por == resource.data.criado_por && request.resource.data.criado_em == resource.data.criado_em
                    && ((canDo('levbe', 'create') && resource.data.criado_por == request.auth.token.email)
                        || (canDo('levbe', 'edit') && request.resource.data.excluido == resource.data.excluido)
                        || (canDo('levbe', 'delete') && request.resource.data.diff(resource.data).affectedKeys()
                              .hasOnly(['excluido', 'excluido_em', 'excluido_por', 'excluido_motivo', 'atualizado_em', 'atualizado_por'])));
      allow delete: if false;
    }
    // fotos e áudios comprimidos do levantamento (um documento por arquivo, até ~700 KB)
    match /levantamento_bota_espera_midia/{id} {
      allow read: if levRead();
      allow create: if (canDo('levbe', 'create') || canDo('levbe', 'edit')) && request.resource.data.id == id
                    && request.resource.data.tipo in ['foto', 'audio'] && request.resource.data.data is string && request.resource.data.data.size() < 1000000
                    && request.resource.data.reg is string && request.resource.data.criado_por == request.auth.token.email;
      allow update, delete: if false;
    }
    // Levantamento de Patologias: mesmas regras do levantamento de bota-espera (cria em nome próprio; o autor complementa e desfaz;
    // "editar" corrige sem excluir; "excluir" só marca a exclusão). Nunca apaga o documento.
    match /levantamento_patologias/{id} {
      allow read: if patRead();
      allow create: if canDo('levpat', 'create') && patOk(request.resource.data) && request.resource.data.id == id
                    && request.resource.data.criado_por == request.auth.token.email && request.resource.data.excluido == false;
      allow update: if patOk(request.resource.data) && request.resource.data.id == id
                    && request.resource.data.criado_por == resource.data.criado_por && request.resource.data.criado_em == resource.data.criado_em
                    && ((canDo('levpat', 'create') && resource.data.criado_por == request.auth.token.email)
                        || (canDo('levpat', 'edit') && request.resource.data.excluido == resource.data.excluido)
                        || (canDo('levpat', 'delete') && request.resource.data.diff(resource.data).affectedKeys()
                              .hasOnly(['excluido', 'excluido_em', 'excluido_por', 'excluido_motivo', 'atualizado_em', 'atualizado_por'])));
      allow delete: if false;
    }
    match /levantamento_patologias_midia/{id} {
      allow read: if patRead();
      allow create: if (canDo('levpat', 'create') || canDo('levpat', 'edit')) && request.resource.data.id == id
                    && request.resource.data.tipo in ['foto', 'audio'] && request.resource.data.data is string && request.resource.data.data.size() < 1000000
                    && request.resource.data.reg is string && request.resource.data.criado_por == request.auth.token.email;
      allow update, delete: if false;
    }
    // Controle de RMPs: um documento por segmento da produção; quem tem "Controle de RMPs: criar" registra e completa. Nada é apagado.
    match /rmp_controle/{id} {
      allow read: if rmpRead();
      allow create, update: if canDo('rmp', 'create') && rmpOk(request.resource.data, id);
      // só o registro de um segmento do RDO excluído definitivamente (id "RDO-…"), por quem valida RDO
      allow delete: if canDo('rdo', 'edit') && id.matches('^RDO-.*');
    }
    // data de corte do controle de pendências de RMP: leitura para quem vê o controle; só o administrador altera
    match /rmp_config/{id} {
      allow read: if rmpRead();
      allow write: if isAdmin() && request.resource.data.corte is string
                   && (request.resource.data.corte == '' || request.resource.data.corte.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }
    match /rmp_controle_midia/{id} {
      allow read: if rmpRead();
      allow create: if canDo('rmp', 'create') && request.resource.data.id == id && request.resource.data.tipo == 'foto'
                    && request.resource.data.data is string && request.resource.data.data.size() < 1000000
                    && request.resource.data.reg is string && request.resource.data.criado_por == request.auth.token.email;
      allow update: if false;
      allow delete: if canDo('rdo', 'edit') && resource.data.reg.matches('^RDO-.*');
    }
    // RDO de massa: cada envio é imutável (correção = novo envio); o arquivo original fica guardado para rastreabilidade
    match /rdo_envios/{id} {
      allow read: if rdoRead();
      allow create: if canDo('rdo', 'create') && request.resource.data.id == id && request.resource.data.data is string
                    && request.resource.data.segs is list && request.resource.data.segs.size() <= 2000 && request.resource.data.enviado_por == request.auth.token.email;
      // validação: só muda a situação (validado ou devolvido), quem validou, quando e a observação; os dados enviados não mudam
      allow update: if canDo('rdo', 'edit') && request.resource.data.status in ['validado', 'devolvido']
                    && request.resource.data.validado_por == request.auth.token.email
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'validado_por', 'validado_em', 'validacao_obs']);
      // exclusão de segmentos da Produção executada: quem valida marca os segmentos excluídos (lista + histórico); os dados enviados não mudam
      allow update: if canDo('rdo', 'edit')
                    && request.resource.data.excl is list && request.resource.data.excl.size() <= 2000
                    && request.resource.data.excl_hist is list && request.resource.data.excl_hist.size() <= 4000
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['excl', 'excl_hist']);
      // exclusão definitiva de segmento: a lista só diminui; o resto do envio não muda
      allow update: if canDo('rdo', 'edit')
                    && request.resource.data.segs is list && request.resource.data.segs.size() < resource.data.segs.size()
                    && request.resource.data.excl_hist is list && request.resource.data.excl_hist.size() <= 4000
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['segs', 't', 'excl', 'excl_hist']);
      // exclusão definitiva do RDO inteiro, por quem valida RDO
      allow delete: if canDo('rdo', 'edit');
    }
    match /rdo_envios_arq/{id} {
      allow read: if rdoRead();
      allow create: if canDo('rdo', 'create') && request.resource.data.id == id && request.resource.data.json is string && request.resource.data.json.size() < 1000000
                    && request.resource.data.enviado_por == request.auth.token.email;
      allow update: if false;
      // apagado junto com o envio na exclusão definitiva do RDO
      allow delete: if canDo('rdo', 'edit');
    }
    match /rdo_config/{id} {
      allow read: if rdoRead();
      allow write: if isAdmin();
    }
    // Assinatura do RDO por link: cada responsável (engenheiro, encarregado, fiscal) recebe um token aleatório (id do documento).
    // Quem tem o link lê o seu documento e assina uma única vez, sem login; encarregado e fiscal só depois do engenheiro.
    // A lista completa só é lida por quem vê o RDO no app.
    match /rdo_assin/{tok} {
      allow get: if true;
      allow list: if rdoRead();
      allow create: if canDo('rdo', 'create') && request.resource.data.status == 'pendente' && request.resource.data.tok == tok
                    && request.resource.data.papel in ['eng', 'enc', 'fis'] && request.resource.data.envio is string && tok.size() >= 24;
      allow update: if resource.data.status == 'pendente' && request.resource.data.status == 'assinado'
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'assinado_nome', 'assinado_funcao', 'assinado_em', 'assinatura', 'ua'])
                    && request.resource.data.assinado_nome is string && request.resource.data.assinado_nome.size() > 1 && request.resource.data.assinado_nome.size() <= 120
                    && request.resource.data.assinatura is string && request.resource.data.assinatura.size() < 200000
                    && request.resource.data.assinatura.matches('data:image/png;base64,.+')
                    && (resource.data.dep == null || get(/databases/$(database)/documents/rdo_assin/$(resource.data.dep)).data.status == 'assinado');
      // quem valida RDO pode refazer (voltar para pendente) ou apagar junto com o RDO
      allow update, delete: if canDo('rdo', 'edit');
    }
    // Responsáveis pelas assinaturas: cadastro feito por quem valida RDO; o id (aleatório, ≥ 24 caracteres) é o endereço pessoal
    // da página de assinaturas. A pessoa, pelo próprio endereço, completa nome, função e assinatura padrão.
    // "docs" = tokens dos documentos enviados para ela assinar (RDO, RMP…): quem envia RDO só acrescenta.
    match /assinantes/{id} {
      allow get: if true;
      allow list: if rdoRead();
      allow create: if canDo('rdo', 'edit') && id.size() >= 24 && request.resource.data.id == id && pesOk(request.resource.data)
                    && request.resource.data.docs.size() == 0 && request.resource.data.ativo == true;
      allow update: if canDo('rdo', 'edit') && request.resource.data.id == id && pesOk(request.resource.data);
      allow update: if canDo('rdo', 'create') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['docs'])
                    && request.resource.data.docs is list && request.resource.data.docs.size() <= 3000 && request.resource.data.docs.hasAll(resource.data.docs);
      allow update: if resource.data.ativo == true && pesOk(request.resource.data)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome', 'funcao', 'assinatura', 'perfil_em'])
                    && request.resource.data.get('assinatura', '').matches('data:image/png;base64,.+') && request.resource.data.perfil_em is int;
      allow delete: if canDo('rdo', 'edit');
    }
    // PDF do RDO gerado (para conferência no link de assinatura): lido por token, gravado por quem envia o RDO
    match /rdo_pdf/{tok} {
      allow get: if true;
      allow list: if false;
      allow create: if canDo('rdo', 'create') && request.resource.data.pdf is string && request.resource.data.pdf.size() < 1000000 && tok.size() >= 24;
      allow update: if false;
      allow delete: if canDo('rdo', 'edit');
    }
    // Histórico de programações: resumo (lista) e dados completos. Cria em nome próprio; o autor altera a própria;
    // "editar" altera a de qualquer usuário; "excluir" só marca a exclusão. Nada é apagado do servidor.
    match /programacoes/{id} {
      allow read: if hpRead();
      allow create: if canDo('histprog', 'create') && hpOk(request.resource.data, id)
                    && request.resource.data.criado_por == request.auth.token.email && request.resource.data.excluido == false;
      allow update: if (hpOk(request.resource.data, id) && request.resource.data.criado_por == resource.data.criado_por && request.resource.data.criado_em == resource.data.criado_em
                        && resource.data.excluido == false && request.resource.data.excluido == false
                        && ((canDo('histprog', 'create') && resource.data.criado_por == request.auth.token.email) || canDo('histprog', 'edit')))
                    || (canDo('histprog', 'delete') && request.resource.data.excluido == true
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['excluido', 'excluido_em', 'excluido_por', 'excluido_por_nome']));
      allow delete: if false;
    }
    match /programacoes_dados/{id} {
      allow read: if hpRead();
      allow create: if canDo('histprog', 'create') && request.resource.data.id == id && request.resource.data.calc is map && request.resource.data.info is map && request.resource.data.rows is list;
      allow update: if request.resource.data.id == id && request.resource.data.calc is map && request.resource.data.info is map && request.resource.data.rows is list
                    && (canDo('histprog', 'edit') || (canDo('histprog', 'create') && get(/databases/$(database)/documents/programacoes/$(id)).data.criado_por == request.auth.token.email));
      allow delete: if false;
    }
    // Base da BR-373 B4 (Lote 04): usuários ativos com "Estacas BR-373 B4", Calculadora, Análise por km, Marcos, Localização estaca ou Foto georreferenciada
    // Produção executada (planilha "Acompanhamento de produção"): dados importados e status do monitoramento.
    // Lê quem usa o app; grava o administrador ou quem tem "Produção executada: criar".
    match /base/{id} {
      allow read: if id in ['producao_meta', 'producao_b23', 'producao_b4', 'producao_status', 'producao_notas'] && (isAdmin() || activeWithAccess());
      allow write: if (id in ['producao_meta', 'producao_b23', 'producao_b4', 'producao_status', 'producao_notas'] && canDo('producao', 'create'))
                   || (id == 'producao_notas' && canDo('rmp', 'create'));
    }
    match /base/b4 {
      allow read: if isAdmin() || (hasMe() && me().active == true && (canView(permsOf(me()), 'mapab4') || canView(permsOf(me()), 'calculadora') || canView(permsOf(me()), 'analise') || canView(permsOf(me()), 'marcos')
                    || canView(permsOf(me()), 'localizacao') || canView(permsOf(me()), 'foto') || canView(permsOf(me()), 'levbe') || canView(permsOf(me()), 'levpat')));
      allow write: if isAdmin();
    }

    // Usuários
    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow update, delete: if isAdmin();
      // primeiro acesso: o próprio usuário cria o registro
      //  - com convite do administrador: exatamente o perfil/permissões do convite
      //  - sem convite: inativo e sem nenhuma permissão, até o administrador autorizar
      allow create: if isAdmin() || (
        signedIn() && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly(['email','name','profile','custom','perms','active','createdAt','invited'])
        && (
          (exists(/databases/$(database)/documents/invites/$(emailKey()))
            && request.resource.data.profile == get(/databases/$(database)/documents/invites/$(emailKey())).data.profile
            && request.resource.data.custom == get(/databases/$(database)/documents/invites/$(emailKey())).data.custom
            && request.resource.data.perms == get(/databases/$(database)/documents/invites/$(emailKey())).data.perms
            && request.resource.data.active == get(/databases/$(database)/documents/invites/$(emailKey())).data.active
            && request.resource.data.invited == true)
          ||
          (request.resource.data.active == false
            && request.resource.data.profile == null
            && request.resource.data.custom == true
            && request.resource.data.perms == {}
            && request.resource.data.invited == false)
        )
      );
    }

    // Perfis de acesso
    match /profiles/{id} {
      allow read: if isAdmin() || hasMe();
      allow write: if isAdmin();
    }

    // Convites (cadastro prévio feito pelo administrador)
    match /invites/{email} {
      allow read: if isAdmin() || (signedIn() && emailKey() == email);
      allow write: if isAdmin();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
